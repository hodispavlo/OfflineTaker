ENVIRONMENT=development
DATABASE_URL=sqlite:///./offlinetaker.db
UPLOAD_DIR=uploads
AI_PROVIDER=mock

# Highest-quality structured transcript with speaker labels:
# AI_PROVIDER=openai
# OPENAI_API_KEY=
# OPENAI_TRANSCRIPTION_MODEL=gpt-4o-transcribe-diarize

# Free local fallback. First run downloads the model:
# AI_PROVIDER=local_whisper
# LOCAL_WHISPER_MODEL=small
# LOCAL_WHISPER_DEVICE=auto
# LOCAL_WHISPER_COMPUTE_TYPE=auto

# Enable one provider when ready:
# AI_PROVIDER=deepgram
# DEEPGRAM_API_KEY=
# AI_PROVIDER=assemblyai
# ASSEMBLYAI_API_KEY=

# Optional summarization:
# OPENAI_API_KEY=
